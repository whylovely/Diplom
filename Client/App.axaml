<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:conv="using:Client.Converters"
             RequestedThemeVariant="Light"
             x:Class="Client.App">

  <Application.Styles>
    <fluent:FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- ══ FLUENT TEMPLATE OVERRIDES (работают поверх FluentTheme) ══ -->

    <!-- TextBox: фон и рамка через шаблон -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="BorderBrush" Value="#1F2937"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>

    <!-- Button: фон через ContentPresenter в шаблоне -->
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5E7EB"/>
    </Style>

    <!-- Button.accent через ContentPresenter -->
    <Style Selector="Button.accent /template/ ContentPresenter">
      <Setter Property="Background" Value="#1F2937"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#374151"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Button.danger через ContentPresenter -->
    <Style Selector="Button.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#DC2626"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FEF2F2"/>
      <Setter Property="Foreground" Value="#DC2626"/>
    </Style>

    <!-- Button.outline через ContentPresenter -->
    <Style Selector="Button.outline /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F9FAFB"/>
    </Style>

    <!-- ComboBox: фон через шаблон -->
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="#1F2937"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
    <!-- ComboBoxItem -->
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
    </Style>

    <!-- ══ GLOBAL FONT ══════════════════════════════════════════ -->
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Plus Jakarta Sans, Segoe UI, sans-serif"/>
    </Style>
    <Style Selector="TemplatedControl">
      <Setter Property="FontFamily" Value="Plus Jakarta Sans, Segoe UI, sans-serif"/>
    </Style>

    <!-- ══ WINDOW ═══════════════════════════════════════════════ -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#FAFAFA"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- ══ BUTTONS ══════════════════════════════════════════════ -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Accent button — первичная тёмная кнопка -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#1F2937"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#374151"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Danger button — деструктивная -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#DC2626"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FEF2F2"/>
      <Setter Property="Foreground" Value="#DC2626"/>
    </Style>

    <!-- outline button — вторичная -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- ══ TEXT INPUTS ══════════════════════════════════════════ -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border">
      <Setter Property="BorderBrush" Value="#1F2937"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="DatePicker">
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- ══ RADIO BUTTONS ═══════════════════════════════════════ -->
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- ══ SEPARATOR ═══════════════════════════════════════════ -->
    <Style Selector="Separator">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Height" Value="0.5"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ══ DATAGRID ════════════════════════════════════════════ -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="RowBackground" Value="#FFFFFF"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#F3F4F6"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- ══ EXPANDER ════════════════════════════════════════════ -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- ══ CONTEXT MENU ═══════════════════════════════════════ -->
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border">
      <Setter Property="Background" Value="#F3F4F6"/>
    </Style>

    <!-- ══ SCROLLBAR ══════════════════════════════════════════ -->
    <Style Selector="ScrollBar">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ══ CARD STYLE CLASS ═══════════════════════════════════ -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style Selector="Border.cardSmall">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- ══ TEXT CLASSES ═══════════════════════════════════════ -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <Style Selector="TextBlock.subheading">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#374151"/>
    </Style>

    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ══ SKELETON LOADING ═══════════════════════════════════ -->
    <Style Selector="Border.skeleton">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Border.skeleton.animating">
      <Style.Animations>
        <Animation Duration="0:0:1.5" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.4"/>
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.8"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.4"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- ══ MONEY CLASSES ══════════════════════════════════════ -->
    <Style Selector="TextBlock.moneyGreen">
      <Setter Property="FontFamily" Value="Fira Code, Consolas, monospace"/>
      <Setter Property="FontFeatures" Value="tnum, zero"/>
      <Setter Property="Foreground" Value="#059669"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.moneyRed">
      <Setter Property="FontFamily" Value="Fira Code, Consolas, monospace"/>
      <Setter Property="FontFeatures" Value="tnum, zero"/>
      <Setter Property="Foreground" Value="#DC2626"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.amount">
      <Setter Property="FontFamily" Value="Fira Code, Consolas, monospace"/>
      <Setter Property="FontFeatures" Value="tnum, zero"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <Style Selector="TextBlock.heroBalance">
      <Setter Property="FontFamily" Value="Fira Code, Consolas, monospace"/>
      <Setter Property="FontFeatures" Value="tnum, zero"/>
      <Setter Property="FontSize" Value="48"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Перевод — профессиональный банковский синий -->
    <Style Selector="TextBlock.cyan">
      <Setter Property="Foreground" Value="#2563EB"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ══ DOCK / TOOLBAR BUTTONS ═════════════════════════════ -->
    <Style Selector="Button.dockItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dockItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dockItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Active dock item -->
    <Style Selector="Button.navDock /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>
    <Style Selector="Button.navDock:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Center Add Button -->
    <Style Selector="Button.dockCenterItem">
      <Setter Property="Background" Value="#1F2937"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dockCenterItem /template/ ContentPresenter">
      <Setter Property="Background" Value="#1F2937"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dockCenterItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#374151"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ══ HEADER BAR ═══════════════════════════════════════════ -->
    <Style Selector="Border.headerBar">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
    </Style>

    <!-- ══ HAMBURGER BUTTON ═══════════ -->
    <Style Selector="Button.hamburgerBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.hamburgerBtn /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.hamburgerBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- ══ DIMMING OVERLAY ══════════════════════════════════════ -->
    <Style Selector="Border.dimOverlay">
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dimOverlay.open">
      <Setter Property="Opacity" Value="0.2"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>

    <!-- ══ FLOATING MENU WRAPPER ════════════════════════════════ -->
    <Style Selector="Border.floatingMenuWrapper">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="RenderTransformOrigin" Value="0%,0%"/>
      <Setter Property="RenderTransform" Value="translate(-8px, -8px) scale(0.96)"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.floatingMenuWrapper.open">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
      <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)"/>
    </Style>

    <!-- ══ MENU ITEMS ═══════════════════════════════════════════ -->
    <Style Selector="Button.menuItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.menuItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Accent menu item (New Transaction) -->
    <Style Selector="Button.menuItemAccent">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.menuItemAccent /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.menuItemAccent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

    <!-- Active menu item -->
    <Style Selector="Button.menuItemActive /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.menuItemActive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>

  </Application.Styles>
</Application>
